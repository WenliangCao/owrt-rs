From: owrt-control-plane-rs H1.3a <noreply@example.invalid>
Subject: [PATCH] mediatek: add fail-closed NMBM recovery read-only mode

This patch is only for the AX3000T stock-layout H1 recovery image. It
keeps the existing NMBM mapping visible while preventing attach-time
table repair, read-side remapping, explicit MTD mutation and BMT debugfs
mutation.

It is not proposed as a normal OpenWrt runtime mode: refusing remap also
refuses NAND healing.  The property is deliberately enabled only in the
dedicated recovery build's target DTS.  The stock profile's flashable
initramfs-factory UBI artifact is also suppressed so this build emits
only the RAM-loadable initramfs candidate.

Signed-off-by: owrt-control-plane-rs H1.3a <noreply@example.invalid>
---
 .../linux/generic/files/drivers/mtd/nand/mtk_bmt.c | 23 +++++++++++++++-
 .../linux/generic/files/drivers/mtd/nand/mtk_bmt.h |  1 +
 .../generic/files/drivers/mtd/nand/mtk_bmt_nmbm.c  | 31 +++++++++++++++++++++-
 .../dts/mt7981b-xiaomi-mi-router-ax3000t.dts       | 15 +++++++++++
 target/linux/mediatek/image/filogic.mk             |  7 +----
 5 files changed, 69 insertions(+), 8 deletions(-)

diff --git a/target/linux/generic/files/drivers/mtd/nand/mtk_bmt.c b/target/linux/generic/files/drivers/mtd/nand/mtk_bmt.c
index 66a82dd2d02a5a014faec5f2c341775d71e3c8fa..567077969fab7d3a6652ba8cbcba1dd4b63316d7 100644
--- a/target/linux/generic/files/drivers/mtd/nand/mtk_bmt.c
+++ b/target/linux/generic/files/drivers/mtd/nand/mtk_bmt.c
@@ -97,6 +97,9 @@ mtk_bmt_remap_block(u32 block, u32 mapped_block, int copy_len)
 {
 	int start, end;
 
+	if (bmtd.read_only)
+		return false;
+
 	if (!mapping_block_in_range(block, &start, &end))
 		return false;
 
@@ -180,6 +183,9 @@ mtk_bmt_write(struct mtd_info *mtd, loff_t to,
 	loff_t cur_to;
 	int ret;
 
+	if (bmtd.read_only)
+		return -EROFS;
+
 	ops->retlen = 0;
 	ops->oobretlen = 0;
 
@@ -237,6 +243,9 @@ mtk_bmt_mtd_erase(struct mtd_info *mtd, struct erase_info *instr)
 	u16 orig_block;
 	int block;
 
+	if (bmtd.read_only)
+		return -EROFS;
+
 	start_addr = instr->addr & (~mtd->erasesize_mask);
 	end_addr = instr->addr + instr->len;
 
@@ -272,7 +281,7 @@ retry:
 	block = bmtd.ops->get_mapping_block(orig_block);
 	ret = bmtd._block_isbad(mtd, (loff_t)block << bmtd.blk_shift);
 	if (ret) {
-		if (mtk_bmt_remap_block(orig_block, block, bmtd.blk_size) &&
+		if (!bmtd.read_only && mtk_bmt_remap_block(orig_block, block, bmtd.blk_size) &&
 		    retry_count++ < 10)
 			goto retry;
 	}
@@ -285,6 +294,9 @@ mtk_bmt_block_markbad(struct mtd_info *mtd, loff_t ofs)
 	u16 orig_block = ofs >> bmtd.blk_shift;
 	int block;
 
+	if (bmtd.read_only)
+		return -EROFS;
+
 	block = bmtd.ops->get_mapping_block(orig_block);
 	if (block < 0)
 		return -EIO;
@@ -370,6 +382,9 @@ mtk_bmt_add_debugfs(void)
 {
 	struct dentry *dir;
 
+	if (bmtd.read_only)
+		return;
+
 	dir = bmtd.debugfs_dir = debugfs_create_dir("mtk-bmt", NULL);
 	if (!dir)
 		return;
@@ -424,6 +439,12 @@ int mtk_bmt_attach(struct mtd_info *mtd)
 	else
 		return 0;
 
+	bmtd.read_only = of_property_read_bool(np, "mediatek,bmt-read-only");
+	if (bmtd.read_only) {
+		mtd->flags &= ~MTD_WRITEABLE;
+		pr_warn("NMBM: forced recovery read-only mode; remap and all MTD mutation are disabled\n");
+	}
+
 	bmtd.remap_range = of_get_property(np, "mediatek,bmt-remap-range",
 					   &bmtd.remap_range_len);
 	bmtd.remap_range_len /= 8;
diff --git a/target/linux/generic/files/drivers/mtd/nand/mtk_bmt.h b/target/linux/generic/files/drivers/mtd/nand/mtk_bmt.h
index 517ff7414f34abbb3ff0f7bc2512e7ae8517f3c2..95941ee97ab594980e5543a2eb0656034527c4f5 100644
--- a/target/linux/generic/files/drivers/mtd/nand/mtk_bmt.h
+++ b/target/linux/generic/files/drivers/mtd/nand/mtk_bmt.h
@@ -28,6 +28,7 @@ struct nmbm_instance;
 
 struct bmt_desc {
 	struct mtd_info *mtd;
+	bool read_only;
 	unsigned char *bbt_buf;
 	unsigned char *data_buf;
 
diff --git a/target/linux/generic/files/drivers/mtd/nand/mtk_bmt_nmbm.c b/target/linux/generic/files/drivers/mtd/nand/mtk_bmt_nmbm.c
index d5827880b2a4854b792978ca4e41b49ea3aa646b..d4cc44fc8b0d20ca21fed9be116aca99d0544248 100644
--- a/target/linux/generic/files/drivers/mtd/nand/mtk_bmt_nmbm.c
+++ b/target/linux/generic/files/drivers/mtd/nand/mtk_bmt_nmbm.c
@@ -273,6 +273,9 @@ static bool nmbm_write_phys_page(struct nmbm_instance *ni, uint64_t addr,
 {
 	int tries, ret;
 
+	if (ni->protected)
+		return false;
+
 	for (tries = 0; tries < NMBM_TRY_COUNT; tries++) {
 		struct mtd_oob_ops ops = {
 			.mode = MTD_OPS_PLACE_OOB,
@@ -306,6 +309,9 @@ static bool nmbm_erase_phys_block(struct nmbm_instance *ni, uint64_t addr)
 {
 	int tries, ret;
 
+	if (ni->protected)
+		return false;
+
 	for (tries = 0; tries < NMBM_TRY_COUNT; tries++) {
 		struct erase_info ei = {
 			.addr = addr,
@@ -343,6 +349,9 @@ static int nmbm_mark_phys_bad_block(struct nmbm_instance *ni, uint32_t ba)
 {
 	uint64_t addr = ba2addr(ni, ba);
 
+	if (ni->protected)
+		return -EROFS;
+
 	nlog_info(ni, "Block %u [0x%08llx] will be marked bad\n", ba, addr);
 
 	return bmtd._block_markbad(bmtd.mtd, addr);
@@ -1549,6 +1558,9 @@ static bool nmbm_map_block(struct nmbm_instance *ni, uint32_t lb)
 	uint32_t pb;
 	bool success;
 
+	if (ni->protected)
+		return false;
+
 	if (ni->mapping_blocks_ba == ni->mapping_blocks_top_ba) {
 		nlog_warn(ni, "No spare unmapped blocks.\n");
 		return false;
@@ -1941,7 +1953,10 @@ static bool nmbm_load_info_table(struct nmbm_instance *ni, uint32_t ba,
 	 * If only one table exists, try to write another table.
 	 * If two tables have different write count, try to update info table
 	 */
-	if (!ni->backup_table_ba) {
+	if (ni->protected) {
+		nlog_warn(ni, "Forced read-only mode; skipping info-table repair\n");
+		success = true;
+	} else if (!ni->backup_table_ba) {
 		success = nmbm_rescue_single_info_table(ni);
 	} else if (main_table_write_count != backup_table_write_count) {
 		/* Mark state & mapping tables changed */
@@ -1991,6 +2006,11 @@ static bool nmbm_load_existing(struct nmbm_instance *ni)
 		return true;
 	}
 
+	if (ni->protected) {
+		nlog_err(ni, "No valid info table in forced read-only mode\n");
+		return false;
+	}
+
 	if (!ni->force_create) {
 		printk("not creating NMBM table\n");
 		return false;
@@ -2175,6 +2195,11 @@ static int nmbm_attach(struct nmbm_instance *ni)
 
 	success = nmbm_find_signature(ni, &ni->signature, &ni->signature_ba);
 	if (!success) {
+		if (ni->protected) {
+			nlog_err(ni, "Signature not found in forced read-only mode\n");
+			return -ENODEV;
+		}
+
 		if (!ni->force_create) {
 			nlog_err(ni, "Signature not found\n");
 			return -ENODEV;
@@ -2217,6 +2242,9 @@ static bool remap_block_nmbm(u16 block, u16 mapped_block, int copy_len)
 	struct nmbm_instance *ni = bmtd.ni;
 	int new_block;
 
+	if (ni->protected)
+		return false;
+
 	if (block >= ni->data_block_count)
 		return false;
 
@@ -2254,6 +2282,7 @@ static int mtk_bmt_init_nmbm(struct device_node *np)
 
 	bmtd.ni = ni;
 
+	ni->protected = bmtd.read_only;
 	if (of_property_read_u32(np, "mediatek,bmt-max-ratio", &ni->max_ratio))
 		ni->max_ratio = 1;
 	if (of_property_read_u32(np, "mediatek,bmt-max-reserved-blocks",
diff --git a/target/linux/mediatek/dts/mt7981b-xiaomi-mi-router-ax3000t.dts b/target/linux/mediatek/dts/mt7981b-xiaomi-mi-router-ax3000t.dts
index d4b11cbe048004b49fc4adcf02020affbef9e387..139161c055ddd19541df8e1b3dc4431935d8f147 100644
--- a/target/linux/mediatek/dts/mt7981b-xiaomi-mi-router-ax3000t.dts
+++ b/target/linux/mediatek/dts/mt7981b-xiaomi-mi-router-ax3000t.dts
@@ -10,16 +10,26 @@
 
 &spi_nand {
 	mediatek,nmbm;
+	mediatek,bmt-read-only;
 	mediatek,bmt-max-ratio = <1>;
 	mediatek,bmt-max-reserved-blocks = <64>;
 	mediatek,bmt-mtd-overridden-oobsize = <64>;
 };
 
 &partitions {
+	partition@100000 {
+		read-only;
+	};
+
+	partition@140000 {
+		read-only;
+	};
+
 	// ubi_kernel is the ubi partition in stock.
 	partition@600000 {
 		label = "ubi_kernel";
 		reg = <0x600000 0x2200000>;
+		read-only;
 	};
 
 	/* ubi is the result of squashing
@@ -31,5 +41,10 @@
 	partition@2800000 {
 		label = "ubi";
 		reg = <0x2800000 0x4e00000>;
+		read-only;
 	};
 };
+
+&wifi {
+	status = "disabled";
+};
diff --git a/target/linux/mediatek/image/filogic.mk b/target/linux/mediatek/image/filogic.mk
index 5ae0305f332b6a5482e687f2f07115d283eb8dfb..d151bc2019a095a37a9f3eb203e25e6cdff65d3c 100644
--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -3277,12 +3277,7 @@ define Device/xiaomi_mi-router-ax3000t
   BLOCKSIZE := 128k
   PAGESIZE := 2048
   DEVICE_PACKAGES := kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware
-ifeq ($(IB),)
-ifneq ($(CONFIG_TARGET_ROOTFS_INITRAMFS),)
-  ARTIFACTS := initramfs-factory.ubi
-  ARTIFACT/initramfs-factory.ubi := append-image-stage initramfs-kernel.bin | ubinize-kernel
-endif
-endif
+  # The H1 recovery build deliberately emits only the RAM-loadable initramfs.
   IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
 endef
 TARGET_DEVICES += xiaomi_mi-router-ax3000t
-- 
