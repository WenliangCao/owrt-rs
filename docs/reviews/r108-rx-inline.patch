+                peer.write_all(frame).unwrap();
+            } else {
+                let (sent, mut witness) = UnixStream::pair().unwrap();
+                assert_eq!(sys::sendmsg_two(peer.as_raw_fd(), frame, &[],
+                    Some(sent.as_raw_fd())).unwrap(), frame.len());
+                witness.write_all(&[i as u8]).unwrap();
+                witnesses.push_back(witness);
+            }
+        }
+        let mut spare = Vec::new();
+        for (i, frame) in frames.iter().enumerate() {
+            let msg = receive(&mut c, &mut spare);
+            check_frame(&msg, frame);
+            if i % 2 == 0 {
+                assert!(msg.fd.is_none());
+            } else {
+                let mut fd = UnixStream::from(msg.fd.unwrap());
+                fd.set_read_timeout(Some(Duration::from_secs(3))).unwrap();
+                let mut byte = [0];
+                fd.read_exact(&mut byte).unwrap();
+                assert_eq!(byte, [i as u8]);
+                drop(fd);
+                let mut witness = witnesses.pop_front().unwrap();
+                witness.set_read_timeout(Some(Duration::from_secs(3))).unwrap();
+                assert_eq!(witness.read(&mut byte).unwrap(), 0, "no leaked received fd");
+            }
