+    fn rx_frame(seq: u16, len: usize) -> Vec<u8> {
+        let mut frame = Header { ty: ty::DATA, seq, peer: 0x87654321 }.encode().to_vec();
+        frame.extend_from_slice(&(len as u32).to_be_bytes());
+        frame.resize(Header::LEN + len, seq as u8);
+        frame
+    }
