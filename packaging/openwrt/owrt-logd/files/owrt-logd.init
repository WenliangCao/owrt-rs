#!/bin/sh /etc/rc.common
# Rust logd (contract C2). Starts only when the operator asked for it: either
# the persistent boot-enable flag or the volatile marker set by
# owrt-logd-switch enable. Same START as the stock log service.
START=12
STOP=89

USE_PROCD=1
PROG=/usr/sbin/logd-rs
BOOT_FLAG=/etc/owrt-logd.boot-enable
RUN_MARKER=/var/run/owrt-logd.enabled

validate_log_daemon()
{
	uci_load_validate system system "$1" "$2" \
		'log_size:uinteger:0' \
		'log_buffer_size:uinteger:0'
}

start_service_daemon()
{
	[ $log_buffer_size -eq 0 -a $log_size -gt 0 ] && log_buffer_size=$log_size
	[ $log_buffer_size -eq 0 ] && log_buffer_size=64
	procd_open_instance logd
	procd_set_param command "$PROG" -S "${log_buffer_size}"
	procd_set_param respawn 5 1 -1
	procd_close_instance
}

start_service()
{
	[ -e "$BOOT_FLAG" ] || [ -e "$RUN_MARKER" ] || return 0
	config_load system
	config_foreach validate_log_daemon system start_service_daemon
}

service_triggers()
{
	procd_add_reload_trigger "system"
}
