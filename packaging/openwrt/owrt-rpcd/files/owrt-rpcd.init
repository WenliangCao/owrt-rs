#!/bin/sh /etc/rc.common
# rpcd-rs service: the complete rpcd replacement (session/uci/rc/file/luci,
# rpc-sys, network.rrdns, luci-rpc, iwinfo). Runs at S11; when the layer is
# enabled the original rpcd's S12 link is removed by owrt-rpcd-switch, so this
# is the only rpcd on the system. Without boot-enable (or the runtime marker)
# this service does nothing.
START=11
STOP=89
USE_PROCD=1

SWITCH=/usr/sbin/owrt-rpcd-switch
MARKER=/var/run/owrt-rpcd.enabled

start_service() {
	if [ ! -e "$MARKER" ]; then
		"$SWITCH" boot-enable status >/dev/null 2>&1 || return 0
		: > "$MARKER"
	fi
	local socket=$(uci -q get rpcd.@rpcd[0].socket)
	local timeout=$(uci -q get rpcd.@rpcd[0].timeout)
	procd_open_instance
	procd_set_param command /usr/sbin/rpcd-rs ${socket:+-s "$socket"} ${timeout:+-t "$timeout"}
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "rpcd"
}

stop_service() {
	rm -f "$MARKER"
}
