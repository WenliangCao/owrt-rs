#!/bin/sh /etc/rc.common
# Rust HTTP front end (contract C3). Builds the same command line as the stock
# /etc/init.d/uhttpd from /etc/config/uhttpd and starts only when the operator
# asked for it (persistent boot-enable flag or volatile marker from the switch).
START=50
STOP=50

USE_PROCD=1
HTTPD_BIN=/usr/sbin/httpd-rs
BOOT_FLAG=/etc/owrt-httpd.boot-enable
RUN_MARKER=/var/run/owrt-httpd.enabled
CALL_LOG=/tmp/owrt-httpd-calls.txt

append_arg() {
	local cfg="$1" var="$2" opt="$3" def="$4" val
	config_get val "$cfg" "$var"
	[ -n "$val" -o -n "$def" ] && procd_append_param command "$opt" "${val:-$def}"
}

append_bool() {
	local cfg="$1" var="$2" opt="$3" def="$4" val
	config_get_bool val "$cfg" "$var" "$def"
	[ "$val" = 1 ] && procd_append_param command "$opt"
}

start_instance() {
	local cfg="$1" realm listen http https path enabled
	realm="$(uci_get system.@system[0].hostname)"
	config_get_bool enabled "$cfg" 'enabled' 1
	[ $enabled -gt 0 ] || return

	procd_open_instance
	procd_set_param respawn
	procd_set_param stderr 1
	procd_set_param command "$HTTPD_BIN" -f --call-log "$CALL_LOG"

	append_arg "$cfg" home "-h"
	append_arg "$cfg" realm "-r" "${realm:-OpenWrt}"
	append_arg "$cfg" cgi_prefix "-x"
	append_arg "$cfg" ubus_prefix "-u"
	append_arg "$cfg" ubus_socket "-U"
	append_bool "$cfg" ubus_cors "-X" 0
	append_arg "$cfg" script_timeout "-t"
	append_arg "$cfg" network_timeout "-T"
	append_arg "$cfg" http_keepalive "-k"
	append_arg "$cfg" tcp_keepalive "-A"
	append_arg "$cfg" error_page "-E"
	append_arg "$cfg" max_requests "-n" 3
	append_arg "$cfg" max_connections "-N"
	append_bool "$cfg" no_ubusauth "-a" 0
	append_bool "$cfg" no_symlinks "-S" 0
	append_bool "$cfg" no_dirlists "-D" 0
	append_bool "$cfg" rfc1918_filter "-R" 0

	config_get http "$cfg" listen_http
	for listen in $http; do
		procd_append_param command -p "$listen"
	done

	config_get https "$cfg" listen_https
	config_get key  "$cfg" key  /etc/uhttpd.key
	config_get cert "$cfg" cert /etc/uhttpd.crt
	[ -n "$https" ] && [ -s "$cert" ] && [ -s "$key" ] && {
		procd_append_param command -C "$cert" -K "$key"
		procd_append_param file "$cert" "$key"
		for listen in $https; do
			procd_append_param command -s "$listen"
		done
	}
	procd_close_instance
}

start_service() {
	[ -e "$BOOT_FLAG" ] || [ -e "$RUN_MARKER" ] || return 0
	config_load uhttpd
	config_foreach start_instance uhttpd
}

service_triggers() {
	procd_add_reload_trigger "uhttpd"
}
