#!/bin/sh
set -eu

CANDIDATE=/usr/sbin/fw4-rs
TARGET=/sbin/fw4
ORIGINAL_SHA256=c240b413a4cf80617ac1a71f601d2e0edae46b0493e3c00fbe883b2446e4a1a6
MOUNTINFO=/proc/self/mountinfo
BOOT_FLAG=/etc/owrt-fw4.boot-enable

usage() {
	printf '%s\n' 'usage: owrt-fw4-switch enable|disable|status|gate|boot-enable on|off|status' >&2
	exit 64
}

is_enabled() {
	[ -r "$MOUNTINFO" ] || return 1
	awk -v target="$TARGET" '$5 == target { found = 1 } END { exit !found }' "$MOUNTINFO"
}

sha256_of() {
	sha256sum "$1" | awk '{ print $1 }'
}

verify_original() {
	[ -f "$TARGET" ] || {
		printf 'missing original generator: %s\n' "$TARGET" >&2
		return 1
	}
	actual=$(sha256_of "$TARGET")
	[ "$actual" = "$ORIGINAL_SHA256" ] || {
		printf 'original generator identity mismatch: %s\n' "$actual" >&2
		return 1
	}
}

# Contract C4 go-live condition: the candidate must render exactly what the
# original renders for the live configuration.
gate() {
	a=$(mktemp) && b=$(mktemp) || return 1
	QUIET=1 "$TARGET" print >"$a" 2>/dev/null; ra=$?
	QUIET=1 "$CANDIDATE" print >"$b" 2>/dev/null; rb=$?
	if [ "$ra" = 0 ] && [ "$rb" = 0 ] && cmp -s "$a" "$b"; then
		printf 'gate: identical (%s lines, sha256 %s)\n' "$(wc -l <"$a")" "$(sha256_of "$a")"
		rm -f "$a" "$b"
		return 0
	fi
	printf 'gate: DIFFERENT (rc %s vs %s)\n' "$ra" "$rb" >&2
	diff "$a" "$b" | head -n 40 >&2
	rm -f "$a" "$b"
	return 2
}

verify_candidate_mount() {
	[ -x "$CANDIDATE" ] && [ -x "$TARGET" ] && cmp -s "$CANDIDATE" "$TARGET"
}

enable_generator() {
	if is_enabled; then
		verify_candidate_mount
		printf '%s\n' enabled
		return
	fi
	[ -x "$CANDIDATE" ] || {
		printf 'missing candidate generator: %s\n' "$CANDIDATE" >&2
		return 1
	}
	verify_original
	gate || return 2
	mount -o bind "$CANDIDATE" "$TARGET"
	if ! is_enabled || ! verify_candidate_mount; then
		umount "$TARGET" 2>/dev/null || true
		printf '%s\n' 'candidate activation verification failed' >&2
		return 1
	fi
	printf '%s\n' enabled
}

disable_generator() {
	if is_enabled; then
		umount "$TARGET"
	fi
	if is_enabled; then
		printf '%s\n' 'candidate generator is still mounted' >&2
		return 1
	fi
	verify_original
	printf '%s\n' disabled
}

status_generator() {
	if is_enabled; then
		verify_candidate_mount
		printf '%s\n' enabled
		return 0
	fi
	verify_original
	printf '%s\n' disabled
	return 3
}

boot_enable() {
	case "${1:-}" in
		on) : > "$BOOT_FLAG"; printf '%s\n' on ;;
		off) rm -f "$BOOT_FLAG"; printf '%s\n' off ;;
		status)
			if [ -e "$BOOT_FLAG" ]; then
				printf '%s\n' on
			else
				printf '%s\n' off
				return 3
			fi
			;;
		*) usage ;;
	esac
}

case "$#:$1" in
	1:enable) enable_generator ;;
	1:disable) disable_generator ;;
	1:status) status_generator ;;
	1:gate) [ -x "$CANDIDATE" ] || exit 1; is_enabled && { printf '%s\n' 'already enabled; gate needs the original at /sbin/fw4' >&2; exit 1; }; verify_original; gate ;;
	2:boot-enable) boot_enable "$2" ;;
	*) usage ;;
esac
