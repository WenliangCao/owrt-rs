#!/bin/sh
# Native-image recovery. Stages verified C originals; never reboots itself.
# Also works from failsafe after mount_root, without ubus or a running netifd.
set -eu
[ "$#" -eq 0 ] || { echo 'usage: owrt-recover-c (then reboot)' >&2; exit 2; }
base=/usr/libexec/owrt-stock
manifest=/usr/share/owrt-control-plane/stock.sha256
release=/usr/share/owrt-control-plane/release.json
test -r /proc/self/mountinfo
layout=$(jsonfilter -i "$release" -e '@.layout')
case "$layout" in
    native-ten) expected_count=12 ;;
    native-eleven) expected_count=13 ;;
    *) echo 'unknown native recovery layout' >&2; exit 1 ;;
esac
manifest_sha=$(jsonfilter -i "$release" -e '@.stock_manifest_sha256')
test "${#manifest_sha}" -eq 64
case "$manifest_sha" in *[!0-9a-f]*) echo 'invalid stock manifest identity' >&2; exit 1 ;; esac
actual_sha=$(sha256sum "$manifest")
test "${actual_sha%% *}" = "$manifest_sha" || { echo 'stock recovery manifest identity mismatch' >&2; exit 1; }
count=$(wc -l < "$manifest")
test "$count" -eq "$expected_count" || { echo "incomplete $layout recovery set" >&2; exit 1; }
test "$(awk 'NF != 2 { exit 1 } {print $2}' "$manifest" | sort -u | wc -l)" -eq "$count"
# The twelve historic paths are mandatory; odhcpd is the only permitted
# thirteenth path. A 12-line subset of the 13-path allowlist is not sufficient.
for target in /sbin/procd /sbin/ubusd /sbin/netifd /sbin/rpcd /sbin/logd /sbin/uci /sbin/fw4 /sbin/reload_config /usr/sbin/uhttpd /usr/sbin/dnsmasq /etc/init.d/dnsmasq /usr/share/acl.d/dnsmasq_acl.json; do
    awk -v source="$base$target" '$2 == source { found++ } END { exit found != 1 }' "$manifest"
done
if [ "$count" -eq 13 ]; then
    awk -v source="$base/usr/sbin/odhcpd" '$2 == source { found++ } END { exit found != 1 }' "$manifest"
fi
sha256sum -c "$manifest" >/dev/null

# Refuse a layered installation: replacing a mounted executable would not
# change the next boot in the intended way.
while read -r hash source; do
    case "$source" in
        "$base"/*) ;;
        *) echo "recovery source is outside stock directory: $source" >&2; exit 1 ;;
    esac
    target=${source#"$base"}
    case "$target" in
        /sbin/procd|/sbin/ubusd|/sbin/netifd|/sbin/rpcd|/sbin/logd|/sbin/uci|/sbin/fw4|/sbin/reload_config|/usr/sbin/uhttpd|/usr/sbin/dnsmasq|/usr/sbin/odhcpd|/etc/init.d/dnsmasq|/usr/share/acl.d/dnsmasq_acl.json) ;;
        *) echo "invalid recovery path: $source" >&2; exit 1 ;;
    esac
    if awk -v target="$target" '$5 == target { found = 1 } END { exit !found }' /proc/self/mountinfo; then
        echo "recovery target is mounted: $target" >&2
        exit 1
    fi
done < "$manifest"

cleanup() {
    while read -r hash source; do
        rm -f "${source#"$base"}.owrt-recovery-new"
    done < "$manifest"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# Prepare and verify the entire set before changing any active path.
while read -r hash source; do
    target=${source#"$base"}
    cp -p "$source" "$target.owrt-recovery-new"
    cmp -s "$source" "$target.owrt-recovery-new"
    case "$target" in
        /usr/share/acl.d/dnsmasq_acl.json) test -r "$target.owrt-recovery-new" ;;
        *) test -x "$target.owrt-recovery-new" ;;
    esac
done < "$manifest"
sync
while read -r hash source; do
    target=${source#"$base"}
    mv -f "$target.owrt-recovery-new" "$target"
    cmp -s "$source" "$target"
done < "$manifest"
sync
echo "All $((count - 2)) C programs and the original dnsmasq init/ACL staged. Reboot to activate the complete C stack."
