  "callers": [
    "option loader calls semantic parser before --test; dnsmasq.c clamps casted edns max below512 after --test",
    "UDP receive_query captures original OPT/DO/limit, decorates before local/cache, saves decorated query, forwards and retries saved bytes",
    "TCP accept nondebug preloads MAC nonlazy in parent; child connection snapshot; each frame decorated before extraction/local/cache; maximum input and decoration limit packet_buff_sz",
    "process_reply checks ECS using peer before signed check/OPT stripping; UDP keeps transaction alive on mismatch; TCP takes m=0 local REFUSED fallback",
    "cacheable=false suppresses dynamic cache reads/insertion but configured local records remain available; actual image DOES match FREC_NO_CACHE peers despite forward.c187 comment; preserve explicit defect witness for source-sensitive coalescing",
    "arp find_mac lazily caches misses90s; nonlazy TCP accept refreshes negatives; only complete kernel snapshots authoritative"
  ],
  "failure_boundaries": [
    "malformed or full EDNS append returns current packet including C partial overwrite/count effects; preserve these in differential",
    "unsafe masks and short ECS reference reads may expose C undefined behaviour; keep deterministic minimal reproducer and explicit safe difference, never delete case",
    "C malloc failure can lose copied options after nonfinal relocation; fail-closed Rust mutation must keep unrelated owner progress",
    "single poll owner may park bounded queries while nonblocking netlink dump completes; no threads or blocking wait"
  ],
