          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:2057-2066,5654-5661",
          "boundary": "Config conf-file empty is a no-op; stdin - is read only once, including nested/repeated references, and emitted records become queryable.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:5666-5680",
          "boundary": "Device/inode deduplication precedes parsing: repeated pathname, hardlink, symlink, recursive pair and cross file/script references execute only once.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:2057-2066,5471-5612",
          "boundary": "Relative includes resolve against process cwd rather than includer directory; nested errors identify the actual source and line, with lexing/failure order retained.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:2080-2191",
          "boundary": "Necessary conf-dir integration only: byte order, suffix/backup filtering, shared inode dedup and nested include failure; conf-dir itself is already closed.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:5471-5612,6059-6094",
          "boundary": "CLI/file duplicate and override semantics, CRLF/comments/quoted file names/final unterminated line, and --test versus actual UDP/TCP DNS results compare strictly.",
          "checked": false,
          "required_scenarios": []
        }
      ],
      "scenarios": [
