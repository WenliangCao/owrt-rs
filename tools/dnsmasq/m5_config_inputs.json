    "conf-script": {
      "checklist": [
        {
          "source": "option.c:2068-2076,5650-5652",
          "boundary": "Execute trusted shell command through /bin/sh; empty directive is no-op, CLI and file input apply output at their source position.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:5650-5685",
          "boundary": "Command string is statted before execution: literal executable paths and hardlinks share inode dedup, commands with arguments/pipelines retain their own execution count.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:5471-5612",
          "boundary": "Generated config has ordinary lexing/include semantics; parser failures report in output from COMMAND, nested file/script errors preserve innermost source.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:5705-5716",
          "boundary": "Successful output changes real UDP/TCP DNS state. Empty stdout and stderr are distinct; nonzero exits, signal termination and missing commands preserve raw wait status plus 10 and exact stderr.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:5684,5705-5716",
          "boundary": "Slow and chunked output is consumed before listener startup, including last unterminated line; no new script execution enters the live poll owner.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:5602-5611,5705-5716",
          "boundary": "Parse-error and normal-exit descendant boundaries: capture parent/child/grandchild completion, reparenting, broken stdout pipe and marker side effects before fixture cleanup.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:5684,5705-5716",
          "boundary": "Pipelines, inherited stdin and nested script output are real shell executions; preserve actual process identity and causality, do not replace scripts with prerecorded output.",
          "checked": false,
          "required_scenarios": []
        },
        {
          "source": "option.c:5705-5716",
          "boundary": "Every run records listener responsiveness or absence, stdout/stderr, process tree and raw wait statuses; reap fixture-owned descendants and verify no PID/listener residue.",
          "checked": false,
          "required_scenarios": []
        }
      ],
      "scenarios": [
        "script-output",
        "script-exit-three",
        "script-signal",
        "script-slow",
        "script-parse-error-tail"
      ]
    }
