  "requirements": [
    {
      "boundary": "Interface names and explicit addresses form a union; an explicit address bypasses except-interface. Loopback is added only for a nonempty interface list.",
      "id": "selection-union",
      "profiles": [
        "ordinary",
        "interface",
        "union",
        "listen-only",
        "empty-interface"
      ],
      "source": "network.c:112-182,500-533"
    },
    {
      "boundary": "First wildcard matches only with a remaining name byte; null selectors never match. Static unknown-name check uses per-address matches.",
      "id": "name-wildcards",
      "profiles": [
        "wildcard-names",
        "wildcard-empty",
        "empty-except",
        "missing",
        "no-address"
      ],
      "source": "util.c:895-910; network.c:123-151"
    },
    {
      "boundary": "IPv4 IFA_LABEL selects an address; packet arrival uses real name. UDP label exception admits only the selected destination; wildcard TCP has no label exception.",
      "id": "ipv4-labels",
      "profiles": [
        "alias",
        "alias-except"
      ],
      "source": "netlink.c:232-260; network.c:214-232,258-270,527-533"
    },
    {
      "boundary": "IPv6 link-local listener scope is the interface index, even for the same address on multiple links; global address scope is zero.",
      "id": "ipv6-scope",
      "profiles": [
        "ordinary",
        "same-link-local",
        "recreate"
      ],
      "source": "network.c:596-628; forward.c:1738-1774"
    },
    {
      "boundary": "Static mode retains listeners when addresses disappear and does not bind later addresses once initial DAD has completed.",
      "id": "static-lifecycle",
      "profiles": [
        "address-change",
        "recreate"
      ],
      "source": "network.c:850-874,1177-1237; dnsmasq.c:1226-1231"
    },
    {
      "boundary": "Dynamic mode opens new addresses and closes last-owner listeners; duplicate owners retain one socket. Recreated interface changes index and link-local scope.",
      "id": "dynamic-lifecycle",
      "profiles": [
        "address-change",
        "recreate",
        "duplicate-address",
        "late-interface"
      ],
      "source": "network.c:674-720,850-874,1177-1237; netlink.c:365-467"
    },
    {
      "boundary": "Tentative IPv6 participates in matching but is never bound; static and dynamic retry after maturity, without exiting or logging EADDRNOTAVAIL.",
      "id": "dad-defer",
      "profiles": [
        "dad",
        "dad-explicit",
        "dad-failed"
      ],
      "source": "netlink.c:290-308; network.c:490-498,1184-1186,1294-1305; dnsmasq.c:1112-1116,1226-1231"
    },
    {
      "boundary": "Static pending-DAD and dynamic binding preserve CAP_NET_BIND_SERVICE for low DNS/TFTP ports after UID change.",
      "id": "dad-capabilities",
      "profiles": [
        "dad-low-port"
      ],
      "source": "dnsmasq.c:500-510"
    },
    {
      "boundary": "Explicit addresses absent from snapshots are still attempted, including loopback aliases; missing dynamic addresses retry silently, static addresses fail.",
      "id": "unowned-address",
      "profiles": [
        "unowned-loopback",
        "missing-address",
        "late-address"
      ],
      "source": "network.c:1212-1235"
    },
    {
      "boundary": "Both bind modes conflict; unknown static names fail after listeners are attempted. Occupied UDP or TCP fails startup in either bound mode. Dynamic only suppresses EADDRNOTAVAIL.",
      "id": "startup-failures",
      "profiles": [
        "conflicting-modes",
        "missing",
        "occupied-udp",
        "occupied-tcp",
        "occupied-tftp"
      ],
      "source": "dnsmasq.c:369-389; network.c:894-966"
    },
    {
      "boundary": "Noninitial failed UDP/TCP/TFTP creation may retain the successful transports and must preserve service/cleanup on release.",
      "id": "partial-dynamic-listener",
      "profiles": [
        "runtime-occupied-udp",
        "runtime-occupied-tcp"
      ],
      "source": "network.c:1087-1133,1184-1200"
    },
    {
      "boundary": "Static IPv4 uses bound-address access; wildcard/dynamic inspect ingress with loopback/UDP-label exceptions. Bound TCP uses socket access in both bound modes.",
      "id": "admission-modes",
      "profiles": [
        "cross-ingress",
        "alias",
        "interface"
      ],
      "source": "forward.c:1625-1636,1780-1803; dnsmasq.c:2048-2109"
    },
    {
      "boundary": "UDP/TCP reply source equals selected destination in IPv4/IPv6 and scoped paths.",
      "id": "reply-source",
      "profiles": [
        "ordinary",
        "union",
        "same-link-local"
      ],
      "source": "forward.c:1999-2005; network.c:964-1009"
    },
    {
      "boundary": "Bound TFTP is constrained by selected DNS addresses and DHCP exclusions; dedicated TFTP names override DHCP exclusion but not bound DNS selection. Wildcard dedicated TFTP bypasses normal DNS interface admission.",
      "id": "tftp-selection",
      "profiles": [
        "tftp",
        "tftp-dedicated",
        "tftp-except",
        "tftp-no-dhcp",
        "tftp-no-v4",
        "tftp-alias"
      ],
      "source": "network.c:535-562; tftp.c:198-233"
    },
    {
      "boundary": "Dynamic TFTP listener add/remove uses address/scope semantics; static DAD TFTP is deferred then binds, ordinary static address additions do not add TFTP.",
      "id": "tftp-lifecycle",
      "profiles": [
        "tftp-change",
        "tftp-dad"
      ],
      "source": "network.c:697-720,1087-1133; tftp.c:99-122"
    },
    {
      "boundary": "Relay request admission shares interface/listen-address union and no-DHCP exclusions; reply ingress can be outside selected downstream, dynamic recreate refreshes ifindex.",
      "id": "relay-combination",
      "profiles": [
        "relay",
        "relay-union",
        "relay-except",
        "relay-no-dhcp",
        "relay-recreate"
      ],
      "source": "dhcp.c:305-368,669-683; network.c:112-151"
    },
    {
      "boundary": "Every daemon, peer and namespace exits; all listeners and fixture links disappear. SIGTERM process group cleanup is recorded.",
      "id": "cleanup",
      "profiles": [
        "all"
      ],
      "source": "network.c:705-720; dnsmasq.c:1180-1206"
    }
  ],
  "schema": 1
