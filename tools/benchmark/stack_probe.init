#!/bin/sh /etc/rc.common
# Disposable service for an authorized whole-stack benchmark.
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /bin/sleep 86400
    procd_close_instance
}
service_triggers() {
    procd_add_reload_trigger owrtstackprobe
}
reload_service() {
    local value
    value=$(/sbin/uci -q get owrtstackprobe.state.value) || return 1
    printf '%s\n' "$value" >> /tmp/owrt-stack-probe/deliveries
    printf '%s\n' "$value" > /tmp/owrt-stack-probe/observed.new
    mv /tmp/owrt-stack-probe/observed.new /tmp/owrt-stack-probe/observed
}
