#!/bin/sh
# Independent native libubus caller diagnostic; existing daemon ELFs only.
set -eu
if [ "${1:-}" = --namespace ]; then
    exec /bin/sh "$(dirname "$0")/isolated.sh" "$@"
fi
[ "$#" -eq 4 ] && [ "$1" = --workload ] && [ "${OWRT_BENCH_NAMESPACE:-}" = 1 ] || exit 125
[ "$2" = ubusd ] && [ "$3" = rs ] && [ "$4" = 10000 ] || exit 125
unset LD_PRELOAD LD_LIBRARY_PATH
bench=/tmp/bin/owrt-benchmark
caller=/tmp/bin/event-benchmark
out=/tmp/out
socket=/var/run/ubus/ubus.sock
mkdir -p /var/run/ubus
cat > "$out/expected-identities.txt" <<'IDENTITIES'
@C_SHA256@  /sbin/ubusd
@CANDIDATE_SHA256@  /tmp/bin/ubusd-rs
@BENCHMARK_SHA256@  /tmp/bin/owrt-benchmark
@CALLER_SHA256@  /tmp/bin/event-benchmark
@NAMESPACE_SHA256@  /tmp/bin/ns-exec
IDENTITIES
cat > "$out/expected-libraries.txt" <<'LIBRARIES'
@LIBRARY_IDENTITIES@
LIBRARIES
sha256sum -c "$out/expected-identities.txt" > "$out/identity-check.log"
sha256sum -c "$out/expected-libraries.txt" > "$out/library-check-before.log"
sha256sum /sbin/ubusd /tmp/bin/ubusd-rs "$bench" "$caller" /tmp/bin/ns-exec > "$out/identities-before.txt"
sha256sum /tmp/bin/ubusd-rs > "$out/binary-sha256.txt"
cat /proc/sys/kernel/random/boot_id > "$out/boot-id.txt"
uname -r > "$out/kernel.txt"
cat /sys/devices/system/cpu/online > "$out/cpus-online.txt"
[ "$(cat "$out/cpus-online.txt")" = 0-1 ]
printf '%s\n' '@ORDER@' > "$out/order.txt"
cat /proc/$$/status > "$out/parent-before.status"
[ "$(awk '/^Cpus_allowed_list:/ {print $2}' "$out/parent-before.status")" = 0-1 ]
pid=
cleanup() {
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
    rm -f "$socket"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
for side in @ORDER@; do
    case "$side" in
        c) bin=/sbin/ubusd; expected_sha=@C_SHA256@ ;;
        candidate) bin=/tmp/bin/ubusd-rs; expected_sha=@CANDIDATE_SHA256@ ;;
        *) exit 125 ;;
    esac
    dest=$out/$side
    mkdir "$dest"
    "$bench" exec-cpu-as 1 "$bin" /sbin/ubusd -s "$socket" > "$dest/daemon.log" 2>&1 & pid=$!
    tries=0
    until ubus -s "$socket" -t 1 list >/dev/null 2>&1; do
        kill -0 "$pid"; [ "$tries" -lt 10 ]; sleep 1; tries=$((tries + 1))
    done
    printf '/sbin/ubusd\0-s\0%s\0' "$socket" > "$dest/expected.cmdline"
    cat /proc/$pid/cmdline > "$dest/before.cmdline"
    cmp "$dest/expected.cmdline" "$dest/before.cmdline"
    sha256sum /proc/$pid/exe > "$dest/before-exe.sha256"
    [ "$(awk '{print $1}' "$dest/before-exe.sha256")" = "$expected_sha" ]
    cat /proc/$pid/status > "$dest/before.status"
    [ "$(awk '/^Cpus_allowed_list:/ {print $2}' "$dest/before.status")" = 1 ]
    cat /proc/$pid/stat > "$dest/before.stat"
    if [ "$side" = c ]; then cat /proc/$pid/maps > "$dest/before.maps"; fi
    cat /proc/stat > "$dest/system-before.stat"
    set -- "$bench" exec-cpu 0 "$caller" "$socket" 10000 20 "$pid"
    printf '%s\0' "$@" > "$dest/caller-command.argv"
    "$@" > "$dest/register_1.json" 2> "$dest/caller.log"
    printf '0\n' > "$dest/caller-exit.txt"
    [ ! -s "$dest/caller.log" ]
    cat /proc/$pid/status > "$dest/after.status"
    cat /proc/$pid/stat > "$dest/after.stat"
    if [ "$side" = c ]; then cat /proc/$pid/maps > "$dest/after.maps"; fi
    [ "$(awk '/^Cpus_allowed_list:/ {print $2}' "$dest/after.status")" = 1 ]
    cat /proc/$pid/cmdline > "$dest/after.cmdline"
    cmp "$dest/before.cmdline" "$dest/after.cmdline"
    sha256sum /proc/$pid/exe > "$dest/after-exe.sha256"
    cmp "$dest/before-exe.sha256" "$dest/after-exe.sha256"
    cat /proc/stat > "$dest/system-after.stat"
    ubus -s "$socket" list > "$dest/objects-after.txt"
    [ ! -s "$dest/objects-after.txt" ] && [ ! -s "$dest/daemon.log" ]
    kill "$pid"
    code=0; wait "$pid" 2>/dev/null || code=$?
    printf '%s\n' "$code" > "$dest/daemon-exit.txt"
    [ "$code" -eq 0 ] || [ "$code" -eq 143 ]
    pid=
    rm -f "$socket"
    [ ! -e "$socket" ]
    touch "$dest/COMPLETE"
done
cat /proc/$$/status > "$out/parent-after.status"
[ "$(awk '/^Cpus_allowed_list:/ {print $2}' "$out/parent-after.status")" = 0-1 ]
sha256sum /sbin/ubusd /tmp/bin/ubusd-rs "$bench" "$caller" /tmp/bin/ns-exec > "$out/identities-after.txt"
cmp "$out/identities-before.txt" "$out/identities-after.txt"
sha256sum -c "$out/expected-libraries.txt" > "$out/library-check-after.log"
touch "$out/COMPLETE"
