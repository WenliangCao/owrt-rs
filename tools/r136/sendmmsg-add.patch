+#[test]
+fn sendmmsg_stream_reports_partial_and_eagain_without_second_frame() {
+    use std::io::Read;
+    use std::os::fd::AsRawFd;
+    use std::os::unix::net::UnixStream;
+    let (sock, mut peer) = UnixStream::pair().unwrap();
+    sock.set_nonblocking(true).unwrap();
+    peer.set_nonblocking(true).unwrap();
+    let first = vec![0xa5; 1024 * 1024];
+    let second = [0x5a; 20];
+    let sent = sendmmsg_two(sock.as_raw_fd(), (&first, &[]), (&second, &[])).unwrap();
+    assert_eq!(sent.completed, 1);
+    assert!(sent.lens[0] > 0 && sent.lens[0] < first.len());
+    assert_eq!(sent.lens[1], 0);
+    let blocked = sendmmsg_two(sock.as_raw_fd(), (&second, &[]), (&second, &[])).unwrap_err();
+    assert_eq!(blocked.kind(), io::ErrorKind::WouldBlock);
+    let mut got = Vec::new();
+    let mut buf = [0; 8192];
+    loop {
+        match peer.read(&mut buf) {
+            Ok(n) => got.extend_from_slice(&buf[..n]),
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => break,
+            other => panic!("read: {other:?}"),
+        }
+    }
+    assert_eq!(got, first[..sent.lens[0]]);
+    let sent = sendmmsg_two(sock.as_raw_fd(), (&second[..8], &second[8..]), (&second, &[])).unwrap();
+    assert_eq!(sent, SendMmsgResult { completed: 2, lens: [20, 20] });
+    let mut got = [0; 40];
+    peer.read_exact(&mut got).unwrap();
+    assert_eq!(got, [0x5a; 40]);
