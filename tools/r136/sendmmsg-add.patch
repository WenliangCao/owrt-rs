+/// entry may be short on a stream.  If an error follows a sent entry Linux
+/// returns the count and suppresses that error; uncounted lengths are zero.
+#[cfg(target_os = "linux")]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SendMmsgResult {
+    pub completed: usize,
+    pub lens: [usize; 2],
+}
