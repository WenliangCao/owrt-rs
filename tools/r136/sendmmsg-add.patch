+    #[test]
+    fn sendmmsg_add_resumes_every_short_write_offset_once() {
+        for blob_len in [12, 20] {
+            let header = Header { ty: ty::DATA, seq: 0xfffe, peer: 0x12345678 };
+            let mut blob = vec![0x5a; blob_len];
+            blob[..4].copy_from_slice(&(blob_len as u32).to_be_bytes());
+            let first_len = Header::LEN + blob_len;
+            let mut expected = header.encode().to_vec();
+            expected.extend_from_slice(&blob);
+            expected.extend_from_slice(&Header { ty: ty::STATUS, ..header }.encode());
+            expected.extend_from_slice(&[0, 0, 0, 12, 1, 0, 0, 8, 0, 0, 0, 0]);
+            for prefix in 0..=expected.len() {
+                let (mut c, mut peer) = rx_pair();
+                peer.set_nonblocking(true).unwrap();
+                if prefix > 0 {
+                    assert_eq!(sys::sendmsg_two(c.fd(), &expected[..prefix], &[], None).unwrap(), prefix);
+                }
+                // Counted entries can be short. completed==0 models any
+                // no-progress error (EAGAIN, EINTR, fatal) without retrying.
+                let result = if prefix == 0 {
+                    sys::SendMmsgResult { completed: 0, lens: [0, 0] }
+                } else if prefix <= first_len {
+                    sys::SendMmsgResult { completed: 1, lens: [prefix, 0] }
+                } else {
+                    sys::SendMmsgResult { completed: 2, lens: [first_len, prefix - first_len] }
+                };
+                c.queue_add_status_tail(header, &blob, result);
+                assert_eq!(c.txq_len, (expected.len() - prefix) as i64);
+                assert!(c.tx.iter().all(|m| m.fd.is_none()));
+                let mut got = Vec::new();
+                let mut buf = [0u8; 128];
+                let deadline = Instant::now() + Duration::from_secs(3);
+                while got.len() < expected.len() || !c.tx_empty() {
+                    assert!(Instant::now() < deadline);
+                    assert!(c.flush());
+                    match peer.read(&mut buf) {
+                        Ok(0) => panic!("EOF"),
+                        Ok(n) => got.extend_from_slice(&buf[..n]),
+                        Err(e) if would_block(&e) => {},
+                        Err(e) => panic!("{e}"),
+                    }
+                }
+                assert_eq!(got, expected, "blob={blob_len}, prefix={prefix}");
+                assert_eq!((c.txq_len, c.txq_ofs), (0, 0));
+                assert!(matches!(peer.read(&mut buf), Err(e) if would_block(&e)));
+            }
+        }
+    }
