+    /// Experimental fixed ADD reply: two protocol writes in one Linux
+    /// syscall. Keep LOOKUP, monitored replies, and queued output unchanged.
+    pub fn send_add_status_reply(&mut self, header: Header, blob: &[u8]) {
+        #[cfg(target_os = "linux")]
+        if self.tx.is_empty() && matches!(blob.len(), 12 | 20) {
+            let status_header = Header { ty: ty::STATUS, ..header };
+            let status_blob = [0, 0, 0, 12, 1, 0, 0, 8, 0, 0, 0, 0];
+            let sent = sys::sendmmsg_two(self.fd(), (&header.encode(), blob),
+                (&status_header.encode(), &status_blob))
+                .unwrap_or(sys::SendMmsgResult { completed: 0, lens: [0, 0] });
+            self.queue_add_status_tail(header, blob, sent);
+            return;
+        }
+        self.send_data_status_reply(header, blob);
+    }
