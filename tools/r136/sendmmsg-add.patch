+    #[cfg(target_os = "linux")]
+    fn queue_add_status_tail(&mut self, header: Header, blob: &[u8], sent: sys::SendMmsgResult) {
+        debug_assert!(self.tx.is_empty());
+        debug_assert!(matches!(blob.len(), 12 | 20));
+        let first_len = Header::LEN + blob.len();
+        let status_header = Header { ty: ty::STATUS, ..header };
+        let status_blob = [0, 0, 0, 12, 1, 0, 0, 8, 0, 0, 0, 0];
+        let second_len = Header::LEN + status_blob.len();
+        let first_written = if sent.completed > 0 { sent.lens[0] } else { 0 };
+        let second_written = if sent.completed > 1 { sent.lens[1] } else { 0 };
+        debug_assert!(sent.completed <= 2 && first_written <= first_len && second_written <= second_len);
+        // Linux stops the vector on a short stream write, so an incomplete
+        // DATA can never be followed by any STATUS bytes from this syscall.
+        debug_assert!(sent.completed < 2 || first_written == first_len);
+        if first_written < first_len {
+            self.txq_ofs = first_written;
+            self.txq_len = -(first_written as i64);
+            self.enqueue(OutMsg { header, blob: blob.to_vec(), fd: None });
+            self.enqueue(OutMsg { header: status_header, blob: status_blob.to_vec(), fd: None });
+        } else if second_written < second_len {
+            self.txq_ofs = second_written;
+            self.txq_len = -(second_written as i64);
+            self.enqueue(OutMsg { header: status_header, blob: status_blob.to_vec(), fd: None });
+        }
+        // Both frames total at most 48 bytes with an initially empty queue,
+        // therefore neither enqueue can cross the unchanged queue cap.
+    }
