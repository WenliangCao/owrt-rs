+/// Submit two descriptor-free stream frames in one Linux `sendmmsg(2)`.
+/// The caller must resume incomplete entries at `lens[i]`, never retry a
+/// whole partially written frame.  The kernel stops after a short entry.
+#[cfg(target_os = "linux")]
+pub fn sendmmsg_two(
+    sock: RawFd,
+    first: (&[u8], &[u8]),
+    second: (&[u8], &[u8]),
+) -> io::Result<SendMmsgResult> {
+    let mut iov = [
+        [
+            IoVec { base: first.0.as_ptr() as *mut u8, len: first.0.len() },
+            IoVec { base: first.1.as_ptr() as *mut u8, len: first.1.len() },
+        ],
+        [
+            IoVec { base: second.0.as_ptr() as *mut u8, len: second.0.len() },
+            IoVec { base: second.1.as_ptr() as *mut u8, len: second.1.len() },
+        ],
+    ];
+    let mut vec = [
+        MMsgHdr {
+            msg_hdr: MsgHdr {
+                name: std::ptr::null_mut(), namelen: 0,
+                iov: iov[0].as_mut_ptr(), iovlen: 2,
+                control: std::ptr::null_mut(), controllen: 0, flags: 0,
+            },
+            msg_len: 0,
+        },
+        MMsgHdr {
+            msg_hdr: MsgHdr {
+                name: std::ptr::null_mut(), namelen: 0,
+                iov: iov[1].as_mut_ptr(), iovlen: 2,
+                control: std::ptr::null_mut(), controllen: 0, flags: 0,
+            },
+            msg_len: 0,
+        },
+    ];
+    // SAFETY: vec and its iovecs point to live slices throughout the syscall;
+    // Linux writes only msg_len fields, and all descriptors are borrowed.
+    let n = unsafe { sendmmsg(sock, vec.as_mut_ptr(), 2, 0) };
+    if n < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(SendMmsgResult {
+        completed: n as usize,
+        lens: [vec[0].msg_len as usize, vec[1].msg_len as usize],
+    })
+}
